# Use Ubuntu 22.04 LTS for stability and long-term support
FROM ubuntu:22.04

# Install necessary build tools and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkgconf python3 \
    git \
    libevent-dev libboost-dev \
    libsqlite3-dev \
    net-tools \
    wget \
    ca-certificates \
    jq \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set up the build environment
WORKDIR /build

RUN git clone -b v29.2.knots20251110+bip110-v0.1rc3 --depth 1 --single-branch --no-tags https://github.com/dathonohm/bitcoin bitcoin && \
    cd bitcoin && \
    ACTUAL_HASH=$(git rev-parse HEAD) && \
    EXPECTED_HASH="37ea81d50eb7d7e235c3ffbd29ac5c3827d17d27" && \
    if [ "$ACTUAL_HASH" != "$EXPECTED_HASH" ]; then \
        echo "Error: Git commit hash mismatch" && \
        echo "Expected: $EXPECTED_HASH" && \
        echo "Actual: $ACTUAL_HASH" && \
        exit 1; \
    fi && \
    cd ..

# Move into the source directory
WORKDIR /build/bitcoin

# Configure and build with CMake
RUN mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_GUI=OFF \
    -DCMAKE_INSTALL_PREFIX=/opt/bitcoin \
    .. && \
    cmake --build . -j$(nproc) && \
    cmake --install .

# Set up the final environment
ENV PATH="/opt/bitcoin/bin:$PATH"

# Create a data directory for bitcoind
RUN mkdir -p /data
VOLUME ["/data"]