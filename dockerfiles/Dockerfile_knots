# Use Ubuntu 22.04 LTS for stability and long-term support
FROM ubuntu:22.04

# Install necessary build tools and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkgconf python3 \
    git \
    libevent-dev libboost-dev \
    libsqlite3-dev \
    net-tools \
    wget \
    ca-certificates \
    jq \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set up the build environment
WORKDIR /build

# Fetch the source code (using a specific tag for reproducibility)
#RUN git clone -b v27.1.knots20240801 --depth 1 --single-branch --no-tags https://github.com/bitcoinknots/bitcoin.git bitcoin
# RUN git clone -b v28.1.knots20250305 --depth 1 --single-branch --no-tags https://github.com/bitcoinknots/bitcoin.git bitcoin
# RUN git clone -b v29.1.knots20250903 --depth 1 --single-branch --no-tags https://github.com/bitcoinknots/bitcoin.git bitcoin && \
# 2f32c966044ac07d614972f7875551093bbd9254
# RUN git clone -b 29.2.knots20251110+UASF-BIP110 --depth 1 --single-branch --no-tags https://github.com/dathonohm/bitcoin bitcoin && \
RUN git clone -b v29.2.knots20251110+bip110-v0.1rc2 --depth 1 --single-branch --no-tags https://github.com/dathonohm/bitcoin bitcoin && \
    cd bitcoin && \
    ACTUAL_HASH=$(git rev-parse HEAD) && \
    EXPECTED_HASH="b4209e32108ebf2d556d72c77138722bf51fa3a5" && \
    if [ "$ACTUAL_HASH" != "$EXPECTED_HASH" ]; then \
        echo "Error: Git commit hash mismatch" && \
        echo "Expected: $EXPECTED_HASH" && \
        echo "Actual: $ACTUAL_HASH" && \
        exit 1; \
    fi && \
    cd ..

# Move into the source directory
WORKDIR /build/bitcoin

# Configure and build with CMake
RUN mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_GUI=OFF \
    -DCMAKE_INSTALL_PREFIX=/opt/bitcoin \
    .. && \
    cmake --build . -j$(nproc) && \
    cmake --install .

# Set up the final environment
ENV PATH="/opt/bitcoin/bin:$PATH"

# Create a data directory for bitcoind
RUN mkdir -p /data
VOLUME ["/data"]